# PostgreSQL 接続情報
# Prisma 7 (driver adapter) では URL クエリの connection_limit / pool_timeout は無効。
# プールサイズは lib/prisma.ts の pg Pool 設定で制御する（下記 DATABASE_POOL_MAX 参照）
DATABASE_URL="postgresql://user:password@host:5432/the_botch"

# pg Pool の最大コネクション数（省略時: Vercel 上は 1、それ以外は 5）
# DATABASE_POOL_MAX=1

# Vercel KV (Redis) 接続情報（統計 API キャッシュ用。lib/stats-cache.ts）
# Vercel ダッシュボードで KV ストアを作成すると自動で環境変数に注入される。
# 未設定の場合は lib/stats-cache.ts はインメモリキャッシュにフォールバックする（ローカル開発時など）。
# KV_REST_API_URL="https://xxxxx.kv.vercel-storage.com"
# KV_REST_API_TOKEN="xxxxxxxx"

# Vercel Blob（男気イベントの写真アップロード用。lib/blob.ts）
# Vercel ダッシュボード > Storage > Blob でストアを作成すると自動で環境変数に注入される。
# 未設定の場合、男気写真アップロード UI は「Blob 未設定」表示になり、他機能には影響しない。
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxx"
