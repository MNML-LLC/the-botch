# PostgreSQL 接続情報
DATABASE_URL="postgresql://user:password@host:5432/the_botch"

# MS Graph (Outlook カレンダー同期)
# Azure AD アプリ登録 → Calendars.ReadWrite (アプリケーション権限) が必要
MSGRAPH_TENANT_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
MSGRAPH_CLIENT_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
MSGRAPH_CLIENT_SECRET="your-client-secret-here"
# 共有メールボックス (デフォルト: thebotch@mnml.co.jp)
MSGRAPH_SHARED_MAILBOX="thebotch@mnml.co.jp"

# Vercel Cron 保護シークレット (inbound-sync エンドポイント認証用)
CRON_SECRET="your-cron-secret-here"
